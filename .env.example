# Claude API 設定
# 從 https://console.anthropic.com/ 取得金鑰
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API 設定（選用，提供給 Aider 或其他工具）
# 從 https://platform.openai.com/api-keys 取得
OPENAI_API_KEY=your_openai_api_key_here

# Database / Docker 共用設定
POSTGRES_USER=investment
POSTGRES_PASSWORD=investment
POSTGRES_DB=investment_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL：唯一真相來源（portfolio-service 只讀此變數）
DATABASE_URL=postgresql://investment:investment@postgres:5432/investment_db

# Sprint 1-2: Google Sheets 整合（Portfolio Service）
# ⚠️ 安全要求：不要把 JSON 內容直接放進 env（避免 docker compose config 外洩）
# 改用檔案路徑掛載（僅保存路徑）
# 例：GOOGLE_SA_JSON_PATH=/secure/keys/google_sa.json
GOOGLE_SA_JSON_PATH=/path/to/google_sa.json

# Google Sheets 試算表 ID（從 URL 取得）
# 範例 URL：https://docs.google.com/spreadsheets/d/1ABC...XYZ/edit
# GOOGLE_SHEET_ID 就是 1ABC...XYZ 這段
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Google Sheets 交易流水帳分頁名稱（預設 "trades"）
GOOGLE_SHEET_TRADES_TAB=trades

# Sprint 1-2: Google Sheets 欄位 mapping（選用，預設值如下）
# 如果你的 Google Sheets 欄位名稱與預設不同，請設定這些變數
SHEET_COL_USER_ID=user_id
SHEET_COL_SYMBOL=symbol
SHEET_COL_ASSET_CCY=asset_ccy
SHEET_COL_SIDE=side
SHEET_COL_QUANTITY=quantity
SHEET_COL_PRICE=price
SHEET_COL_FEE=fee
SHEET_COL_TRADE_DATE=trade_date
SHEET_COL_BROKER=broker

# 其他第三方 API 金鑰（依需求自行新增）
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# FINNHUB_API_KEY=your_finnhub_key
