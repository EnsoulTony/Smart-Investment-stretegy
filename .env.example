# Claude API 設定
# 從 https://console.anthropic.com/ 取得金鑰
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API 設定（選用，提供給 Aider 或其他工具）
# 從 https://platform.openai.com/api-keys 取得
OPENAI_API_KEY=your_openai_api_key_here

# Database / Docker 共用設定
POSTGRES_USER=investment
POSTGRES_PASSWORD=investment
POSTGRES_DB=investment_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://investment:investment@postgres:5432/investment_db

# 其他第三方 API 金鑰（依需求自行新增）
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
# FINNHUB_API_KEY=your_finnhub_key
