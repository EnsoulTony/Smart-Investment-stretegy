name: smart-investment-strategy
services:
  postgres:
    image: postgres:16
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-investment}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-investment}
      POSTGRES_DB: ${POSTGRES_DB:-investment_db}
    volumes:
    - postgres_data:/var/lib/postgresql/data
    ports:
    - 5432:5432
    security_opt:
    - apparmor:unconfined
  api-gateway:
    build:
      context: .
      dockerfile: services/api-gateway/Dockerfile
    environment:
      PORT: 8000
      SERVICE_NAME: api-gateway
      DATABASE_URL: ${DATABASE_URL:-postgresql://investment:investment@postgres:5432/investment_db}
    depends_on:
    - postgres
    ports:
    - 8000:8000
    security_opt:
    - apparmor:unconfined
  portfolio-service:
    build:
      context: .
      dockerfile: services/portfolio-service/Dockerfile
    env_file:
    - .env
    environment:
      GOOGLE_SA_JSON: ${GOOGLE_SA_JSON}
      PORT: 8001
      SERVICE_NAME: portfolio-service
      DATABASE_URL: ${DATABASE_URL:-postgresql://investment:investment@postgres:5432/investment_db}
    depends_on:
    - postgres
    ports:
    - 8001:8001
    security_opt:
    - apparmor:unconfined
  radar-service:
    build:
      context: .
      dockerfile: services/radar-service/Dockerfile
    environment:
      PORT: 8002
      SERVICE_NAME: radar-service
      DATABASE_URL: ${DATABASE_URL:-postgresql://investment:investment@postgres:5432/investment_db}
    depends_on:
    - postgres
    ports:
    - 8002:8002
    security_opt:
    - apparmor:unconfined
  news-service:
    build:
      context: .
      dockerfile: services/news-service/Dockerfile
    environment:
      PORT: 8003
      SERVICE_NAME: news-service
      DATABASE_URL: ${DATABASE_URL:-postgresql://investment:investment@postgres:5432/investment_db}
    depends_on:
    - postgres
    ports:
    - 8003:8003
    security_opt:
    - apparmor:unconfined
  research-service:
    build:
      context: .
      dockerfile: services/research-service/Dockerfile
    environment:
      PORT: 8004
      SERVICE_NAME: research-service
      DATABASE_URL: ${DATABASE_URL:-postgresql://investment:investment@postgres:5432/investment_db}
    depends_on:
    - postgres
    ports:
    - 8004:8004
    security_opt:
    - apparmor:unconfined
  frontend:
    build:
      context: .
      dockerfile: frontend/Dockerfile
    environment:
      VITE_API_BASE_URL: http://api-gateway:8000
    depends_on:
    - api-gateway
    ports:
    - 8080:4173
    security_opt:
    - apparmor:unconfined
volumes:
  postgres_data: null
